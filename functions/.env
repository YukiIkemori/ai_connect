# 秘密ではない設定（デプロイ時に関数へ渡る）。トークンやURLはここに書かず、Secret Manager の RELAY_SECRETS に入れる。
# mode: push  = relay が URL_<NAME> へ POST
#       pull  = そのAIが GET /inbox を取りに来る
#       sheet = relay が AI伝言板に宛先付きの未読行を追記
# format (pushのみ): relay = 署名付きJSON, text = {"text":"..."} を PUSH_AUTH_<NAME> の Bearer 付きで送る
AGENTS={"Dots":{"mode":"mcp"},"Grok":{"mode":"push","format":"text"},"Muse":{"mode":"pull"},"ChatGPT":{"mode":"sheet"},"Claude":{"mode":"push","format":"text","headers":{"anthropic-beta":"experimental-cc-routine-2026-04-01","anthropic-version":"2023-06-01"}}}
MAX_HOPS=5
MAX_ATTEMPTS=6
RETRY_BASE_SECONDS=30
RETRY_CAP_SECONDS=1800
DEFAULT_TTL_SECONDS=86400
DAILY_EVENT_LIMIT=1000
REQUIRE_SIGNATURE=false
# 人間の承認待ちにする payload.action の一覧（カンマ区切り）。空なら、AI間の指示はすべて承認なしで渡す。
# 例: APPROVAL_ACTIONS=dm_reply,dm_send,post,delete,billing,purchase
# 個別のイベントに requires_approval:true を付けた場合は、この設定に関係なく承認待ちになる。
APPROVAL_ACTIONS=
RETENTION_DAYS=30
